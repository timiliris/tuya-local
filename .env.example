# Replace this example with the LAN IPv4 address of the computer running Docker.
TUYA_HOST_IP=192.168.1.10
# The interface and RTSP are restricted to this computer by default.
TUYA_BIND_ADDRESS=127.0.0.1
TUYA_HTTP_PORT=18788
TUYA_PUBLIC_HOST=127.0.0.1

# Optional web access password (12+ characters). Never commit your real .env.
TUYA_ACCESS_PASSWORD=
# Explicit DNS hostnames, comma-separated; private IP addresses work by default.
TUYA_ALLOWED_HOSTS=
# HTTPS reverse proxy origin, e.g. https://cameras.example.com (no path).
TUYA_PUBLIC_ORIGIN=
